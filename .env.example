# Copia este archivo como .env y rellena los valores. NUNCA subas .env a GitHub.
TELEGRAM_TOKEN=pega_aqui_el_token_de_BotFather
# Tu ID de Telegram (el bot te lo dice con /id). Solo este usuario puede hablar con Monet.
OWNER_ID=
# Clave de la API de Claude (opcional por ahora; sin ella Monet funciona en modo basico)
ANTHROPIC_API_KEY=
# Modelo: haiku es el mas barato
MONET_MODEL=claude-haiku-5-5
# Voz de Edge TTS (gratis). Otras: es-MX-JorgeNeural, es-ES-AlvaroNeural, es-MX-DaliaNeural
MONET_VOICE=es-MX-JorgeNeural
